# ── Cloudinary (media CDN) ─────────────────────────────────────────────
# Defaults already point at the Orgix cloud — override only if you change clouds.
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=dwjr5yrir
# Unsigned upload preset (created via API / console; allows browser uploads only
# into orgix-media/…, never needs your API secret).
NEXT_PUBLIC_CLOUDINARY_PRESET=orgix_web

# Set to 1 to serve images from /public/images instead of the Cloudinary CDN.
NEXT_PUBLIC_MEDIA_LOCAL=0

# ── Contact form ────────────────────────────────────────────────────────
# Optional JSON endpoint (Formspree / Web3Forms / your future /api/contact).
# When empty the form falls back to a pre-filled mailto link. No PHP involved.
NEXT_PUBLIC_FORM_ENDPOINT=

# ── Server-side Cloudinary admin (migration scripts only — never commit) ──
# CLOUDINARY_URL=cloudinary://API_KEY:API_SECRET@dwjr5yrir
